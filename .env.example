# Copiar a .env y completar. scripts/deploy.sh genera uno con secretos aleatorios
# si no existe. .env nunca se versiona.

# Dominio público del gateway (debe resolver al túnel de Cloudflare)
PUBLIC_HOST=recetarapida.ansayan.com

# PostgreSQL: superusuario y un rol por microservicio
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
AUTH_DB_PASSWORD=
PRESCRIPTIONS_DB_PASSWORD=

# Firma de los JWT (mínimo 64 caracteres) y vigencia en milisegundos
JWT_SECRET=
JWT_EXPIRATION=86400000

# Rama o commit de cada repositorio a construir
REF_AUTH=main
REF_PRESCRIPTION=main
REF_GATEWAY=main
REF_FRONT=main
